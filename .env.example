# Copy to .env and fill in. .env is gitignored and must stay that way.

# gemini (default) or ollama
FOODSAFE_PROVIDER=gemini

# Required for the Gemini provider. https://aistudio.google.com/apikey
GEMINI_API_KEY=
FOODSAFE_GEMINI_MODEL=gemini-3.5-flash

# Local fallback. Used automatically when Gemini cannot generate.
FOODSAFE_MODEL=gemma4:26b
OLLAMA_BASE_URL=http://localhost:11434
